window {
    width: 600px;
    background-color: @bg;
    border: 2px;
    border-color: @border;
    border-radius: 8px;
}
mainbox { padding: 12px; spacing: 8px; background-color: transparent; }
listview { lines: 8; scrollbar: false; background-color: transparent; }
element { padding: 6px 10px; border-radius: 6px; background-color: transparent; text-color: @fg; }
element selected.normal { background-color: @accent; text-color: @accent-fg; }
element-text { background-color: transparent; text-color: inherit; }
element-icon { size: 24px; background-color: transparent; }
inputbar {
    children: [ textbox-arch, entry ];
    padding: 8px 12px;
    background-color: @surface;
    border-radius: 6px;
    spacing: 10px;
}
textbox-arch {
    padding: 0 6px 0 2px;
    vertical-align: 0.5;
    font: "GeistMono Nerd Font 14";
    expand: false;
    str: "󰣇 ";
    text-color: @accent;
    background-color: transparent;
}
entry {
    text-color: @fg;
    placeholder: "Search...";
    placeholder-color: @dim;
    background-color: transparent;
}
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}
